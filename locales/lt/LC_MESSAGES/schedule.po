msgid "Scheduled sessions will now be announced in {channel}"
msgstr "Suplanuotos sesijos dabar bus skelbiamos {channel}"

#: src/modules/schedule/settings.py:102
msgctxt "guildset:session_lobby|set_response|unset"
msgid "The schedule session lobby has been unset. Shutting down scheduled session system."
msgstr "Sesijų laukimo kanalas pašalintas. Suplanuotų sesijų sistema išjungiama."

