msgctxt "timer|status|stage:focus|statusline"
msgid "{channel} is now in **FOCUS**! Good luck, **BREAK** starts {timestamp}"
msgstr "{channel}现在处于**专注**模式！加油，**休息**将在{timestamp}开始"

