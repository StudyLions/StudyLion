msgctxt "guildset:session_channels|set_response|set"
msgid "Activity in the following sessions will now count towards scheduled session attendance: {channels}"
msgstr ""

#: src/modules/schedule/settings.py:207
msgctxt "guildset:session_channels|set_response|unset"
msgid "Activity in all (tracked) voice channels will now count towards session attendance."
msgstr ""

