msgstr "Tham dự tối thiểu phải là số nguyên phút từ `1` đến `60`."

#: src/modules/schedule/settings.py:452
msgctxt "guildset:schedule_blacklist_role"
msgid "schedule_blacklist_role"
msgstr "schedule_blacklist_role"

#: src/modules/schedule/settings.py:455
msgctxt "guildset:schedule_blacklist_role|desc"
msgid "Role which disables scheduled session booking."
msgstr "Vai trò vô hiệu hóa việc đặt phiên theo lịch."

#: src/modules/schedule/settings.py:459
msgctxt "guildset:schedule_blacklist_role|long_desc"
msgid "Members with this role will not be allowed to book scheduled sessions in this server. If the role is manually added, all future scheduled sessions for the user are cancelled. This provides a way to stop repeatedly unreliable members from blocking the group bonus for all members. Alternatively, consider setting the booking cost (and reward) very high to provide a strong disincentive for not attending a session."
msgstr ""

#: src/modules/schedule/settings.py:467
msgctxt "guildset:schedule_blacklist_role|accepts"
