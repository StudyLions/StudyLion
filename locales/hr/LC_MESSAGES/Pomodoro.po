msgstr ""
"Nije naveden `timer_channel` i nemate dozvolu 'Manage Channels' za stvaranje"
" nove sobe!"

#: src/modules/pomodoro/cog.py:652
msgctxt "cmd:pomodoro_create|new_channel|error:my_insufficient_perms|title"
