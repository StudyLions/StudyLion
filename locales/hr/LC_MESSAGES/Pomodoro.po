msgstr "timer"

#: src/modules/pomodoro/cog.py:402
msgctxt "cmd:timer|desc"
msgid "Show your current (or selected) pomodoro timer."
msgstr "Prikaži trenutni (ili odabrani) pomodoro mjerač."

