#: src/modules/schedule/cog.py:493
msgctxt "create_booking|error:no_lobby"
msgid "This server has not set a `session_lobby`, so the scheduled session system is disabled!"
msgstr "इस सर्वर ने `session_lobby` सेट नहीं किया है, इसलिए निर्धारित सत्र प्रणाली अक्षम है!"

#: src/modules/schedule/cog.py:505
msgctxt "create_booking|error:no_member"
msgid "An unknown Discord error occurred. Please try again in a few minutes."
msgstr "एक अज्ञात Discord त्रुटि हुई। कृपया कुछ मिनटों में पुनः प्रयास करें।"

#: src/modules/schedule/cog.py:513
msgctxt "create_booking|error:blacklisted"
msgid "You have been blacklisted from the scheduled session system in this server."
msgstr "आपको इस सर्वर में निर्धारित सत्र प्रणाली से ब्लैकलिस्ट किया गया है।"

#, possible-python-brace-format
msgctxt "create_booking|error:insufficient_balance"
msgid "Booking a session costs {coin}**{required}**, but you only have {coin}**{balance}**."
msgid_plural "Booking `{count}` sessions costs {coin}**{required}**, but you only have {coin}**{balance}**."
msgstr[0] "एक सत्र बुक करने की लागत {coin}**{required}** है, लेकिन आपके पास केवल {coin}**{balance}** है।"
msgstr[1] ""

#: src/modules/schedule/cog.py:538
msgctxt "create_booking|error:already_booked"
msgid "One or more requested timeslots are already booked!"
msgstr "एक या अधिक अनुरोधित टाइमस्लॉट पहले से बुक हैं!"

#: src/modules/schedule/cog.py:741
msgctxt "cmd:schedule"
msgid "schedule"
msgstr "schedule"

#: src/modules/schedule/cog.py:744
msgctxt "cmd:schedule|desc"
msgid "View and manage your scheduled session."
msgstr "अपनी निर्धारित सत्र देखें और प्रबंधित करें।"

#: src/modules/schedule/cog.py:749
msgctxt "cmd:schedule|param:cancel"
