msgstr "Τι θα πρέπει να είναι η υπενθύμιση;"

#: src/modules/reminders/cog.py:595
msgctxt "cmd:remindme_in|param:every|desc"
msgid "How often to repeat this reminder. (e.g. 1 day, or 2h)"
