msgstr "Πώς πρέπει να ονομαστεί ο ρόλος χρώματος;"

#: src/modules/shop/shops/colours.py:392
msgctxt "cmd:editshop_colours_create|param:price|desc"
msgid "How much should the colour role cost?"
