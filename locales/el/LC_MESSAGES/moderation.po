msgid "Moderation tickets will be sent to {channel}"
msgstr "Τα δελτία συντονισμού θα αποστέλλονται στο {channel}"

#: src/modules/moderation/settings.py:53
msgctxt "guildset:ticket_log|set_response:unset"
