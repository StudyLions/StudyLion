msgstr "計時器已停止！加入{channel}來啟動計時器。"

#: src/modules/pomodoro/timer.py:598
msgctxt "timer|status|stopped:manual"
msgid "Timer stopped! Press `Start` to restart the timer."
msgstr "計時器已停止！按`Start`重新啟動計時器。"

