msgstr ""
"Les notifications du minuteur Pomodoro seront désormais envoyées dans "
"{channel}"

#: src/modules/pomodoro/settings.py:58
msgctxt "guildset:pomodoro_channel|set_response|unset"
msgid "Pomodoro timer notifications will now default to their voice channel."
msgstr ""
"Les notifications du minuteur Pomodoro seront envoyées dans le canal vocal."

#, possible-python-brace-format
