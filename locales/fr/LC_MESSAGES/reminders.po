#, possible-python-brace-format
msgctxt "create_reminder|error:past"
msgid "The provided reminder time {timestamp} is in the past!"
msgstr "L'heure de rappel {timestamp} est dans le passé !"

#: src/modules/reminders/cog.py:123
msgctxt "create_reminder|error:too_fast"
msgid "You cannot set a repeating reminder with a period less than 10 minutes."
msgstr "Vous ne pouvez pas définir un rappel récurrent avec un intervalle inférieur à 10 minutes."

#: src/modules/reminders/cog.py:133
msgctxt "create_reminder|error:too_many"
msgid "Sorry, you have reached the maximum of `25` reminders."
msgstr "Désolé, vous avez atteint le maximum de `25` rappels."

#: src/modules/reminders/cog.py:149
msgctxt "create_reminder|error:cannot_dm"
msgid "I cannot direct message you! Do you have me blocked or direct messages closed?"
msgstr "Je ne peux pas vous envoyer de message direct ! M'avez-vous bloqué ou avez-vous fermé les messages directs ?"

#, possible-python-brace-format
msgctxt "parse_timestamp|error:parse"
msgid "Could not parse `{given}` as a valid reminder time. Try entering the time in the form `HH:MM` or `YYYY-MM-DD HH:MM`."
msgstr "Impossible d'interpréter `{given}` comme une heure de rappel valide. Essayez d'entrer l'heure au format `HH:MM` ou `YYYY-MM-DD HH:MM`."

