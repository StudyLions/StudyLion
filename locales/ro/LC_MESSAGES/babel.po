msgstr "Ne pare rău, nu suportăm limba `{lang}` în acest moment!"

#: src/babel/settings.py:77
msgctxt "userset:locale"
msgid "language"
msgstr "language"

#: src/babel/settings.py:78
msgctxt "userset:locale|desc"
msgid "Your preferred language for interacting with me."
msgstr "Limba ta preferată pentru a interacționa cu mine."

#: src/babel/settings.py:81
msgctxt "userset:locale|long_desc"
msgid "The language you would prefer me to respond to commands and interactions in. Servers may be configured to override this with their own language."
msgstr "Limba în care preferi să răspund. Serverele pot suprascrie aceasta cu propria limbă."

#: src/babel/settings.py:92
msgctxt "userset:locale|response"
msgid "You have unset your language."
msgstr "Ai eliminat limba ta."

#, possible-python-brace-format
msgctxt "userset:locale|response"
msgid "You have set your language to {lang}."
msgstr "Ai setat limba ta la {lang}."

#: src/babel/settings.py:113
msgctxt "guildset:force_locale"
msgid "force_language"
msgstr "force_language"

#: src/babel/settings.py:115
msgctxt "guildset:force_locale|desc"
msgid "Whether to force all members to use the configured guild language when interacting with me."
msgstr "Dacă să forțezi toți membrii să folosească limba configurată a serverului."

#: src/babel/settings.py:118
msgctxt "guildset:force_locale|long_desc"
msgid "When enabled, commands in this guild will always use the configured guild language, regardless of the member's personally configured language."
msgstr "Când este activat, comenzile vor folosi întotdeauna limba serverului, indiferent de limba personală a membrului."

#: src/babel/settings.py:122
msgctxt "guildset:force_locale|output"
msgid "Enabled (members will be forced to use the server language)"
msgstr "Activat (membrii vor fi forțați să folosească limba serverului)"

#: src/babel/settings.py:123
msgctxt "guildset:force_locale|output"
msgid "Disabled (members may set their own language)"
msgstr "Dezactivat (membrii pot seta propria limbă)"

#: src/babel/settings.py:137
msgctxt "guildset:force_locale|response"
msgid "I will always use the set language in this server."
msgstr "Voi folosi întotdeauna limba setată pe acest server."

#: src/babel/settings.py:142
msgctxt "guildset:force_locale|response"
msgid "I will now allow the members to set their own language here."
msgstr "Acum voi permite membrilor să seteze propria limbă."

#: src/babel/settings.py:160
msgctxt "guildset:locale"
msgid "language"
msgstr "language"

#: src/babel/settings.py:161
msgctxt "guildset:locale|desc"
msgid "Your preferred language for interacting with me."
msgstr "Limba ta preferată pentru a interacționa cu mine."

#: src/babel/settings.py:164
msgctxt "guildset:locale|long_desc"
msgid "The default language to use for responses and interactions in this server. Member's own configured language will override this for their commands unless `force_language` is enabled."
msgstr "Limba implicită pentru răspunsuri pe acest server. Limba proprie a membrului va suprascrie aceasta, cu excepția cazului în care `force_language` este activat."

#: src/babel/settings.py:176
msgctxt "guildset:locale|response"
msgid "You have unset the guild language."
msgstr "Ai eliminat limba serverului."

#, possible-python-brace-format
msgctxt "guildset:locale|response"
msgid "You have set the guild language to {lang}."
msgstr "Ai setat limba serverului la {lang}."

