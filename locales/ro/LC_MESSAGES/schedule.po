msgstr "Numele sau id-ul canalului de lobby al sesiunii."

#, possible-python-brace-format
msgctxt "guildset:session_lobby|set_response|set"
msgid "Scheduled sessions will now be announced in {channel}"
msgstr "Sesiunile programate vor fi acum anunțate în {channel}"

#: src/modules/schedule/settings.py:102
msgctxt "guildset:session_lobby|set_response|unset"
msgid "The schedule session lobby has been unset. Shutting down scheduled session system."
msgstr "Lobby-ul sesiunilor a fost eliminat. Se oprește sistemul de sesiuni programate."

