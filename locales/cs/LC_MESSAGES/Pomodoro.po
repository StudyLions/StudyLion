msgctxt "timer|status|stage:break|statusline"
msgid ""
"{channel} is now on **BREAK**! Take a rest, **FOCUS** starts {timestamp}"
msgstr ""
"{channel} je nyní na **PŘESTÁVCE**! Odpočiňte si, **SOUSTŘEDĚNÍ** začíná "
"{timestamp}"

