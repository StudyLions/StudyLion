msgid "Timer stopped! Join {channel} to start the timer."
msgstr ""
"Таймерът е спрян! Присъединете се към {channel}, за да стартирате таймера."

#: src/modules/pomodoro/timer.py:598
msgctxt "timer|status|stopped:manual"
