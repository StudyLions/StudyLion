#: src/modules/user_config/cog.py:38
msgctxt "userset:timezone"
msgid "timezone"
msgstr "timezone"

#: src/modules/user_config/cog.py:41
msgctxt "userset:timezone|desc"
msgid "Timezone in which to display statistics."
msgstr "Часова зона за показване на статистиката."

#: src/modules/user_config/cog.py:45
msgctxt "userset:timezone|long_desc"
msgid "All personal time-related features of StudyLion will use this timezone for you, including personal statistics. Note that leaderboards will still be shown in the server's own timezone."
msgstr "Всички лични функции, свързани с времето в StudyLion, ще използват тази часова зона за вас, включително личната статистика. Имайте предвид, че класациите ще се показват в часовата зона на сървъра."

#, possible-python-brace-format
msgctxt "userset:timezone|response:set"
msgid "Your personal timezone has been set to `{timezone}`."
msgstr "Личната ви часова зона е зададена на `{timezone}`."

#: src/modules/user_config/cog.py:65
msgctxt "userset:timezone|response:unset"
msgid "You have unset your timezone. Statistics will be displayed in the server timezone."
msgstr "Премахнахте часовата си зона. Статистиката ще се показва в часовата зона на сървъра."

#: src/modules/user_config/cog.py:81
msgctxt "cmd:userconfig"
msgid "my"
msgstr "my"

#: src/modules/user_config/cog.py:82
msgctxt "cmd:userconfig|desc"
msgid "User configuration commands."
msgstr "Команди за потребителска конфигурация."

#: src/modules/user_config/cog.py:89
msgctxt "cmd:userconfig_timezone"
msgid "timezone"
msgstr "timezone"

#: src/modules/user_config/cog.py:92
msgctxt "cmd:userconfig_timezone|desc"
msgid "Set your personal timezone, used for displaying stats and setting reminders."
msgstr "Задайте личната си часова зона, използвана за показване на статистика и настройка на напомняния."

#: src/modules/user_config/cog.py:96
msgctxt "cmd:userconfig_timezone|param:timezone"
msgid "timezone"
msgstr "timezone"

#: src/modules/user_config/cog.py:101
msgctxt "cmd:userconfig_timezone|param:timezone|desc"
msgid "What timezone are you in? Try typing your country or continent."
msgstr "В коя часова зона сте? Опитайте да напишете вашата страна или континент."

#, possible-python-brace-format
msgctxt "cmd:userconfig_timezone|response:set"
msgid "Your timezone is currently set to {timezone}"
msgstr "Часовата ви зона в момента е {timezone}"

#: src/modules/user_config/cog.py:121
msgctxt "cmd:userconfig_timezone|button:reset|label"
msgid "Reset"
msgstr "Нулиране"

#, possible-python-brace-format
msgctxt "cmd:userconfig_timezone|response:unset"
msgid "Your timezone is not set. Using the server timezone `{timezone}`."
msgstr "Часовата ви зона не е зададена. Използва се часовата зона на сървъра `{timezone}`."
