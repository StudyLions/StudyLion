"Időzítő sikeresen létrehozva! Használd az alábbi panelt a konfiguráláshoz."

#: src/modules/pomodoro/cog.py:770
msgctxt "cmd:pomodoro_destroy"
msgid "destroy"
msgstr "destroy"

#: src/modules/pomodoro/cog.py:773
msgctxt "cmd:pomodoro_destroy|desc"
