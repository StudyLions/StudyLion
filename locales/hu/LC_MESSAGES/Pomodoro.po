msgstr ""
"A `Manage Channels` jogosultság szükséges a(z) {channel} csatornában az "
"időzítő eltávolításához!"

#, possible-python-brace-format
msgctxt "cmd:pomdoro_destroy|response:success|description"
msgid "Timer successfully removed from {channel}."
msgstr "Időzítő sikeresen eltávolítva a(z) {channel} csatornából."

