msgctxt "cmd:pomodoro_destroy|param:channel"
msgid "Select a timer voice channel to remove the timer from."
msgstr ""

#: src/modules/pomodoro/cog.py:798
msgctxt "cmd:pomodoro_destroy|error:no_timer"
