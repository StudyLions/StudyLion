msgid "in"
msgstr "in"

#: src/modules/reminders/cog.py:576
msgctxt "cmd:remindme_in|desc"
msgid "Schedule a reminder for a given amount of time in the future."
msgstr "Planen eine Erinnerung für eine bestimmte Zeit in der Zukunft."

