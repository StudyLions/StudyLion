#: src/utils/cog.py:18
msgctxt "cmd:page"
msgid "page"
msgstr "page"

#: src/utils/cog.py:21
msgctxt "cmd:page|desc"
msgid ""
"Jump to a given page of the ouput of a previous command in this channel."
msgstr ""
"Zu einer bestimmten Seite der Ausgabe eines vorherigen Befehls in diesem "
"Kanal springen."

