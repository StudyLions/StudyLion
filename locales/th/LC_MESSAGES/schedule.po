#: src/modules/schedule/cog.py:493
msgctxt "create_booking|error:no_lobby"
msgid "This server has not set a `session_lobby`, so the scheduled session system is disabled!"
msgstr "เซิร์ฟเวอร์นี้ไม่ได้ตั้งค่า `session_lobby` ดังนั้นระบบเซสชันที่กำหนดเวลาจึงถูกปิดใช้งาน!"

