#: src/babel/cog.py:99
msgctxt "cmd:configure_language"
msgid "language"
msgstr "language"

#: src/babel/cog.py:101
msgctxt "cmd:configure_language|desc"
msgid "Configure the default language I will use in this server."
msgstr "กำหนดค่าภาษาเริ่มต้นที่ฉันจะใช้ในเซิร์ฟเวอร์นี้"

#, possible-python-brace-format
msgctxt "cmd:configure_language|error"
msgid "You cannot enable `{force_setting}` without having a configured language!"
msgstr "คุณไม่สามารถเปิดใช้งาน `{force_setting}` โดยไม่มีภาษาที่กำหนดค่าไว้!"

#: src/babel/cog.py:165
msgctxt "cmd:configure_language|success"
msgid "Language settings updated!"
msgstr "อัปเดตการตั้งค่าภาษาแล้ว!"

