#: src/modules/reminders/cog.py:363
msgctxt "cmd:reminders_cancel"
msgid "cancel"
msgstr "cancel"

#: src/modules/reminders/cog.py:366
msgctxt "cmd:reminders_cancel|desc"
msgid "Cancel a single reminder. Use /reminders to clear or cancel multiple reminders."
msgstr "Peruuta yksittäinen muistutus. Käytä /reminders poistaaksesi tai peruuttaaksesi useita muistutuksia."

#: src/modules/reminders/cog.py:370
msgctxt "cmd:reminders_cancel|param:reminder"
