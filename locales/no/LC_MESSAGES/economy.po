msgctxt "cmd:send|error:sending-to-self"
msgid ""
"What is this, tax evasion?\n"
"(You can not send coins to yourself.)"
msgstr ""
"Hva er dette, skatteunndragelse?\n"
"(Du kan ikke sende mynter til deg selv.)"

