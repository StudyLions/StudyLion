#: src/tracking/text/ui.py:46
msgctxt "ui:text_tracker_config|menu:untracked_channels|placeholder"
msgid "Select Untracked Channels"
msgstr "Velg usporede kanaler"

#: src/tracking/text/ui.py:53
msgctxt "ui:text_tracker_config|embed|title"
msgid "Message Tracking Configuration Panel"
msgstr "Konfigureringspanel for meldingssporing"

#: src/tracking/text/ui.py:90
msgctxt "dash:text_tracking|title"
msgid "Message XP configuration ({commands[config message_exp]})"
msgstr "Meldings-XP konfigurasjon ({commands[config message_exp]})"

#: src/tracking/text/ui.py:94
msgctxt "dash:text_tracking|dropdown|placeholder"
msgid "Message XP Panel"
msgstr "Meldings-XP panel"

#: src/tracking/text/settings.py:35
msgctxt "guildset:xp_per_period"
msgid "xp_per_5min"
msgstr "xp_per_5min"

#: src/tracking/text/settings.py:38
msgctxt "guildset:xp_per_period|desc"
msgid "How much XP members will be given every 5 minute period they are active."
msgstr "Hvor mye XP medlemmer vil bli gitt for hver 5 minutters aktiv periode."

#: src/tracking/text/settings.py:42
msgctxt "guildset:xp_per_period|long_desc"
msgid "Amount of message XP to give members for each 5 minute period in which they are active (send a message). Note that this XP is only given *once* per period."
msgstr "Mengde meldings-XP til medlemmer for hver 5 minutters periode de er aktive (sender en melding). Denne XP gis kun *én gang* per periode."

#: src/tracking/text/settings.py:47
msgctxt "guildset:xp_per_period|accepts"
msgid "Number of message XP to reward per 5 minute active period."
msgstr "Antall meldings-XP som belønning per 5 minutters aktiv periode."

#, possible-python-brace-format
msgctxt "guildset:xp_per_period|set_response"
msgid "For every **5** minutes they are active (i.e. in which they send a message), members will now be given **{amount}** XP."
msgstr "For hver **5** minutter de er aktive (dvs. sender en melding), vil medlemmer nå motta **{amount}** XP."

#: src/tracking/text/settings.py:68
msgctxt "guildset:word_xp"
msgid "xp_per_100words"
msgstr "xp_per_100words"

#: src/tracking/text/settings.py:71
msgctxt "guildset:word_xp|desc"
msgid "How much XP members will be given per hundred words they write."
msgstr "Hvor mye XP medlemmer vil bli gitt per hundre ord de skriver."

#: src/tracking/text/settings.py:75
msgctxt "guildset:word_xp|long_desc"
msgid "Amount of message XP to be given (additionally to the XP per period) for each hundred words. Useful for rewarding communication."
msgstr "Mengde meldings-XP (i tillegg til XP per periode) per hundre ord. Nyttig for å belønne kommunikasjon."

#: src/tracking/text/settings.py:80
msgctxt "guildset:word_xp|accepts"
msgid "Number of XP to reward per hundred words sent."
msgstr "Antall XP som belønning per hundre sendte ord."

#, possible-python-brace-format
msgctxt "guildset:word_xp|set_response"
msgid "For every **100** words they send, members will now be rewarded an additional **{amount}** XP."
msgstr "For hver **100** ord de sender, vil medlemmer nå bli belønnet med ytterligere **{amount}** XP."

#: src/tracking/text/settings.py:99
msgctxt "guildset:untracked_text_channels"
msgid "untracked_text_channels"
msgstr "untracked_text_channels"

#: src/tracking/text/settings.py:102
msgctxt "guildset:untracked_text_channels|desc"
msgid "Channels in which Message XP will not be given."
msgstr "Kanaler hvor meldings-XP ikke vil bli gitt."

#: src/tracking/text/settings.py:106
msgctxt "guildset:untracked_text_channels|long_desc"
msgid "Messages sent in these channels will not count towards a member's message XP. If a category is selected, then all channels under the category will also be untracked."
msgstr "Meldinger sendt i disse kanalene vil ikke telles mot et medlems meldings-XP. Hvis en kategori er valgt, vil alle kanaler under kategorien også være usporede."

#: src/tracking/text/settings.py:111
msgctxt "guildset:untracked_text_channels|accepts"
msgid "Comma separated list of untracked text channel names or ids."
msgstr "Kommaseparert liste over usporede tekstkanalnavn eller IDer."

#: src/tracking/text/settings.py:115
msgctxt "guildset:untracked_text_channels|notset"
msgid "Not Set (all text channels will be tracked.)"
msgstr "Ikke satt (alle tekstkanaler vil bli sporet.)"

#, possible-python-brace-format
msgctxt "guildset:untracked_text_channels|set_response|set"
msgid "Messages in or under the following channels will be ignored: {channels}"
msgstr "Meldinger i følgende kanaler vil bli ignorert: {channels}"

#: src/tracking/text/settings.py:137
msgctxt "guildset:untracked_text_channels|set_response|notset"
msgid "Message XP will now be tracked in every channel."
msgstr "Meldings-XP vil nå bli sporet i alle kanaler."

#: src/tracking/text/settings.py:146
msgctxt "guildset:untracked_text_channels|set_using"
msgid "Channel selector below"
msgstr "Kanalvelger nedenfor"

#: src/tracking/text/settings.py:177
msgctxt "botset:xp_per_period"
msgid "xp_per_5min"
msgstr "xp_per_5min"

#: src/tracking/text/settings.py:180
msgctxt "botset:xp_per_period|desc"
msgid "How much global XP members will be given every 5 minute period they are active."
msgstr "Hvor mye globalt XP medlemmer vil bli gitt for hver 5 minutters aktiv periode."

#: src/tracking/text/settings.py:184
msgctxt "botset:xp_per_period|long_desc"
msgid "Amount of global message XP to give members for each 5 minute period in which they are active (send a message). Note that this XP is only given *once* per period."
msgstr "Mengde globalt meldings-XP for hver 5 minutters aktiv periode (sender en melding). Denne XP gis kun *én gang* per periode."

#: src/tracking/text/settings.py:190
msgctxt "botset:xp_per_period|accepts"
msgid "Number of message XP to reward per 5 minute active period."
msgstr "Antall meldings-XP som belønning per 5 minutters aktiv periode."

#, possible-python-brace-format
msgctxt "leoset:xp_per_period|set_response"
msgid "For every **5** minutes they are active (i.e. in which they send a message), all users will now be given **{amount}** global XP."
msgstr "For hver **5** minutter de er aktive (dvs. sender en melding), vil alle brukere nå motta **{amount}** globalt XP."

#: src/tracking/text/settings.py:210
msgctxt "botset:word_xp"
msgid "xp_per_100words"
msgstr "xp_per_100words"

#: src/tracking/text/settings.py:213
msgctxt "botset:word_xp|desc"
msgid "How much global XP members will be given per hundred words they write."
msgstr "Hvor mye globalt XP medlemmer vil bli gitt per hundre ord de skriver."

#: src/tracking/text/settings.py:217
msgctxt "botset:word_xp|long_desc"
msgid "Amount of global message XP to be given (additionally to the XP per period) for each hundred words. Useful for rewarding communication."
msgstr "Mengde globalt meldings-XP (i tillegg til XP per periode) per hundre ord. Nyttig for å belønne kommunikasjon."

#: src/tracking/text/settings.py:222
msgctxt "botset:word_xp|accepts"
msgid "Number of XP to reward per hundred words sent."
msgstr "Antall XP som belønning per hundre sendte ord."

#, possible-python-brace-format
msgctxt "leoset:word_xp|set_response"
msgid "For every **100** words they send, users will now be rewarded an additional **{amount}** global XP."
msgstr "For hver **100** ord de sender, vil brukere nå bli belønnet med ytterligere **{amount}** globalt XP."
